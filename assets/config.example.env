# WordPress 凭据模板 (config.example.env)
# 复制为 config.env 并填值；或直接 export 到 shell。绝不提交进 git。

# WP 用户名（后台「用户」里显示的用户名，如 ricky）
WP_USER=your_wp_username

# 应用密码（后台「用户 → 应用密码」生成，名字如 hermes-draft）
# 可带空格，脚本会自动去空格。建议用「仅能建草稿」的专用密码，用完即吊销。
WP_APP_PASS='xxxx xxxx xxxx xxxx xxxx xxxx'

# 站点根地址
WP_SITE='https://your-site.com'

# 使用方式：
#   source config.env
#   python3 publish_draft.py draft.md
